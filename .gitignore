.worktrees/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.egg/
build/
dist/
.vscode/
.idea/

# Per-user local agent state — never meant to be shared (contains local
# paths, personal permission rules, etc). Some agent CLIs already exclude
# this via global gitignore config, but pin it here too so a fresh clone on
# any machine is safe by default.
.claude/settings.local.json

# Runtime state written by the causal-graph harness (facts.json, evidence.json,
# deductions.json, causal_edges.json, audit_log.jsonl, pending_review.jsonl,
# _meta.json, .lock) — not committed docs. A topic's committed docs, if any,
# would live directly under research/<topic>/, not inside a graph/
# subdirectory, so they'd be unaffected by this rule.
research/*/graph/

docs/traces/
